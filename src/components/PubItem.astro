---
// 论文条目（学术引用格式）：作者, "标题," 期刊, 卷期页码, 年份.
// impact：显示影响因子标签；ccf：显示会议的 CCF 等级标签；
// filterable=false 时不带筛选用的 data 属性（论文页顶部「高影响因子论文」用，不参与筛选和计数）
import { t, asset, displayAuthors, categoryById, categoryColor, pubType, type Lang, type Publication } from '../lib/site';

interface Props {
  pub: Publication;
  lang: Lang;
  reveal?: boolean;
  delay?: number;
  showTopic?: boolean;
  impact?: number;
  ccf?: string;
  filterable?: boolean;
}
const { pub, lang, reveal = false, delay = 0, showTopic = true, impact, ccf, filterable = true } = Astro.props;

const authors = displayAuthors(pub.authors);
const doiUrl = pub.doi ? (/^https?:/.test(pub.doi) ? pub.doi : `https://doi.org/${pub.doi}`) : '';
const titleHref = pub.url || doiUrl || asset(pub.pdf);
const cat = categoryById(pub.category);
const type = pubType(pub);
const search = [pub.title, ...(pub.authors ?? []), pub.venue, pub.short, pub.year, t(pub.topic, 'zh'), t(pub.topic, 'en'), t(cat?.name, 'zh'), t(cat?.name, 'en')]
  .join(' ')
  .toLowerCase();
---

<li
  class="cite"
  style={`--c:${categoryColor(pub.category)};${reveal ? `--d:${delay}ms` : ''}`}
  data-pub={filterable ? '' : undefined}
  data-year={filterable ? pub.year : undefined}
  data-type={filterable ? type : undefined}
  data-category={filterable ? (pub.category ?? '') : undefined}
  data-search={filterable ? search : undefined}
  data-reveal={reveal ? '' : undefined}
>
  <div class="cite-tags">
    {pub.short && <span class="cite-venue">{pub.short}</span>}
    {impact !== undefined && <span class="cite-if">IF {impact.toFixed(1)}</span>}
    {ccf && <span class="cite-if">CCF-{ccf}</span>}
    {/* 分类标签：显示论文的具体研究主题（topic），圆点颜色和悬停提示为所属大类 */}
    {showTopic && (pub.topic || cat) && <span class="cite-dir" title={t(cat?.name, lang)}><i></i>{t(pub.topic, lang) || t(cat?.name, lang)}</span>}
    {pub.badge && <span class="cite-badge">{t(pub.badge, lang)}</span>}
  </div>
  <p class="cite-text">
    <span class="cite-authors">
      {
        authors.map((a, i) =>
          a === '…' ? (
            <span class="pub-ellipsis">{i < authors.length - 1 ? '…, ' : lang === 'zh' ? '等' : 'et al.'}</span>
          ) : (
            <>
              <span class:list={[{ 'is-member': a.member }]}>
                {a.name}
                {a.equal && <sup>#</sup>}
                {a.corr && <sup>*</sup>}
              </span>
              {i < authors.length - 1 && ', '}
            </>
          ),
        )
      }
    </span>
    , “{titleHref ? <a class="cite-title" href={titleHref} target="_blank" rel="noopener">{pub.title}</a> : <span class="cite-title">{pub.title}</span>},”{' '}
    <em>{pub.venue}</em>{pub.volume && <>, {pub.volume}</>}, {pub.year}.
  </p>
  {
    (doiUrl || pub.pdf || pub.code) && (
      <p class="cite-links">
        {doiUrl && (
          <a href={doiUrl} target="_blank" rel="noopener">
            [DOI]
          </a>
        )}
        {pub.pdf && (
          <a href={asset(pub.pdf)} target="_blank" rel="noopener">
            [PDF]
          </a>
        )}
        {pub.code && (
          <a href={pub.code} target="_blank" rel="noopener">
            [Code]
          </a>
        )}
      </p>
    )
  }
</li>
