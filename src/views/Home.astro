---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import NetCanvas from '../components/NetCanvas.astro';
import {
  site,
  research,
  news,
  life,
  publications,
  patents,
  projects,
  newsLink,
  pi,
  t,
  list,
  href,
  asset,
  paragraphs,
  formatDate,
  dateParts,
  initials,
  avatarColors,
  type Lang,
} from '../lib/site';
import { ui } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const u = ui[lang];
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const pad = (n: number) => String(n).padStart(2, '0');

const latest = news.slice(0, 6);
// 首页数据栏：填了 auto 的项目按网站数据自动计数，保证与各页面列表一致
const autoValue: Record<string, number> = {
  papers: publications.length,
  patents: patents.filter((p) => p.status === 'granted').length,
  projects: projects.filter((p) => p.role === 'lead').length,
  directions: research.length,
};
const stats: any[] = (site.stats ?? []).map((s: any) => (s.auto && s.auto in autoValue ? { ...s, value: autoValue[s.auto] } : s));
const piBio = paragraphs(t(pi.bio, lang));
const piOther = t(pi.name, other);
// 导师的研究兴趣；没填时用课题组的研究方向
const piInterests = list(pi.interests, lang).length ? list(pi.interests, lang) : research.map((r) => t(r.short, lang));
const [pc1, pc2] = avatarColors(t(pi.name, 'en'));
const piTile = `--c1:${pc1};--c2:${pc2}`;

// 页尾滚动的期刊与会议；条目少时重复补满，保证无缝滚动
const venues: string[] = site.venues ?? [];
const marqueeVenues = venues.length ? Array.from({ length: Math.ceil(16 / venues.length) }, () => venues).flat() : [];
const tickerNews = news.slice(0, 8);
// 团队生活：最新 5 个有封面的相册（第一个放大）
const lifeTeaser = life
  .map((a: any) => ({ ...a, coverSrc: a.cover || (a.photos ?? []).find((p: any) => /\.(jpe?g|png|webp)$/i.test(p?.src ?? ''))?.src }))
  .filter((a: any) => a.coverSrc)
  .slice(0, 5);
---

<Base lang={lang}>
  <h1 class="sr-only">{t(site.name, lang)}{t(site.affiliation, lang) && ` · ${t(site.affiliation, lang)}`}</h1>

  <!-- 滚动新闻播报 -->
  <section class="ticker" aria-label={u.home.newsTitle}>
    <div class="container ticker-inner">
      <a class="ticker-label" href={href('news', lang)}>
        <span class="ticker-dot" aria-hidden="true"></span>
        {u.home.tickerLabel}
      </a>
      <div class="ticker-viewport" data-marquee data-speed="60">
        <div class="marquee-track">
          {
            [0, 1].map((k) => (
              <ul aria-hidden={k === 1 ? 'true' : undefined}>
                {tickerNews.map((n) => {
                  const l = newsLink(n, lang);
                  return (
                    <li>
                      <time datetime={n.date}>{formatDate(n.date, lang)}</time>
                      <a href={l.url} target={l.external ? '_blank' : undefined} rel="noopener" tabindex={k === 1 ? -1 : undefined}>
                        {t(n.title, lang)}
                      </a>
                    </li>
                  );
                })}
              </ul>
            ))
          }
        </div>
      </div>
      <a class="ticker-more" href={href('news', lang)}>{u.home.allNews}<Icon name="arrow" size={14} /></a>
    </div>
  </section>

  <!-- 导师详细介绍（原首页轮播改为固定展示） -->
  <section class="home-pi-band" aria-labelledby="home-pi-name">
    <div class="container home-pi" id="director">
      <div class="home-pi-side">
        <div class="home-pi-photo" style={piTile}>
          {pi.photo ? <img src={asset(pi.photo)} alt={t(pi.name, lang)} /> : <span aria-hidden="true">{initials(pi.name, lang)}</span>}
        </div>
        <section class="home-pi-interests">
          <h3>{u.people.interests}</h3>
          <ul class="slide-pi-tags">
            {piInterests.map((x) => (
              <li>{x}</li>
            ))}
          </ul>
        </section>
        {
          (pi.positions ?? []).length > 0 && (
            <section class="home-pi-positions">
              <h3>{u.people.positions}</h3>
              <ul class="pi-timeline">
                {(pi.positions ?? []).map((e: any) => (
                  <li>
                    <span class="pi-when">{t(e.when, lang)}</span>
                    <span class="pi-what">{t(e.what, lang)}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <div class="home-pi-main">
        <p class="slide-eyebrow">{u.home.piSlideEyebrow}</p>
        <h2 class="home-pi-name" id="home-pi-name">
          {t(pi.name, lang)}
          {piOther !== t(pi.name, lang) && <span>{piOther}</span>}
        </h2>
        <p class="home-pi-title">{t(pi.title, lang)}</p>
        <div class="home-pi-bio">
          {piBio.map((para) => (
            <p>{para}</p>
          ))}
        </div>
        <div class="home-pi-actions">
          {
            pi.email && (
              <a class="btn btn-primary" href={`mailto:${pi.email}`}>
                <Icon name="mail" />
                {pi.email}
              </a>
            )
          }
          {(pi.links ?? []).map((l: any) => (
            <a class="btn btn-outline" href={l.url} target="_blank" rel="noopener">
              {t(l.label, lang)}
              <Icon name="external" size={14} />
            </a>
          ))}
        </div>
      </div>

      <aside class="home-pi-facts">
        {
          [
            [u.people.education, pi.education ?? []],
            [u.people.work, pi.experience ?? []],
          ].map(([label, rows]: any) =>
            rows.length > 0 && (
              <section>
                <h3>{label}</h3>
                <ul class="pi-timeline">
                  {rows.map((e: any) => (
                    <li>
                      <span class="pi-when">{t(e.when, lang)}</span>
                      <span class="pi-what">{t(e.what, lang)}</span>
                    </li>
                  ))}
                </ul>
              </section>
            ),
          )
        }
      </aside>
    </div>
  </section>

  <!-- 关于 -->
  <section class="container home-about">
    <div>
      <SectionHead title={u.home.aboutTitle} en={u.home.aboutEn} />
      <p class="about-lead" data-words>{t(site.intro, lang)}</p>
    </div>
    <dl class="about-stats">
      {
        stats.map((s, i) => (
          <div class="about-stat" data-reveal style={`--d:${i * 90}ms`}>
            <dd data-count={s.value} data-suffix={s.suffix ?? ''}>
              {s.value}
              {s.suffix}
            </dd>
            <dt>{t(s.label, lang)}</dt>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- 新闻 + 侧栏 -->
  <div class="band-soft">
  <div class="container home-grid">
    <section class="home-main">
      <SectionHead title={u.home.newsTitle} en={u.home.newsEn}>
        <a slot="action" class="sec-more" href={href('news', lang)}>{u.home.allNews}<Icon name="arrow" size={15} /></a>
      </SectionHead>
      <ul class="news-list">
        {
          latest.map((n, i) => {
            const d = dateParts(n.date);
            const { url: link, external } = newsLink(n, lang);
            return (
              <li class="news-row" data-reveal style={`--d:${i * 80}ms`}>
                <a class="news-thumb" href={link} tabindex="-1" aria-hidden="true" target={external ? '_blank' : undefined} rel="noopener">
                  {n.image ? (
                    <img src={asset(n.image)} alt="" loading="lazy" />
                  ) : (
                    <span class="news-tile">
                      <b class:list={{ 'is-long': String(n.tag ?? '').length > 10 }}>{n.tag ?? `${d.m}/${d.d}`}</b>
                      <small>{d.y}</small>
                    </span>
                  )}
                </a>
                <div class="news-body">
                  <a class="news-title" href={link} target={external ? '_blank' : undefined} rel="noopener">
                    {t(n.title, lang)}
                  </a>
                  <span class="news-meta">
                    <time class="news-date" datetime={n.date}>
                      {formatDate(n.date, lang)}
                    </time>
                  </span>
                  {n.body && <p class="news-excerpt">{t(n.body, lang)}</p>}
                </div>
              </li>
            );
          })
        }
      </ul>
    </section>

    <aside class="home-side">
      <section class="side-card" data-reveal>
        <h2 class="side-title">{u.home.sideResearch}</h2>
        <ul class="side-dirs">
          {
            research.map((r) => (
              <li>
                <a href={`${href('research', lang)}#${r.id}`} style={`--c:${r.color}`}>
                  <span class="side-dir-icon">
                    <Icon name={r.icon} size={15} />
                  </span>
                  {t(r.title, lang)}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="side-card side-join" data-reveal style="--d:100ms">
        <h2 class="side-title">{u.home.joinTitle}</h2>
        <p>{u.home.joinShort}</p>
        <a class="btn btn-orange btn-sm" href={href('join', lang)}>{u.home.joinBtn}<Icon name="arrow" size={16} /></a>
      </section>
    </aside>
  </div>
  </div>

  <!-- 研究方向（深蓝色背景带） -->
  <section class="band-navy">
    <NetCanvas density={0.5} />
    <div class="container home-section">
    <SectionHead title={u.home.researchTitle} en={u.home.researchEn} desc={t(site.pages?.research, lang)}>
      <a slot="action" class="sec-more" href={href('research', lang)}>{u.home.allResearch}<Icon name="arrow" size={15} /></a>
    </SectionHead>
    <div class="sub-grid">
      {
        research.map((r, i) => (
          <a class="sub-card" href={`${href('research', lang)}#${r.id}`} style={`--c:${r.color};--d:${(i % 2) * 100}ms`} data-reveal>
            <span class="sub-icon">
              <Icon name={r.icon} size={26} />
            </span>
            <span class="sub-body">
              <span class="sub-num">{pad(i + 1)}</span>
              <h3 class="sub-title">{t(r.title, lang)}</h3>
              <span class="sub-en">{t(r.title, other)}</span>
              <span class="sub-sum">{t(r.summary, lang)}</span>
              <span class="sub-more">
                {u.common.learnMore}
                <Icon name="arrow" size={15} />
              </span>
            </span>
          </a>
        ))
      }
    </div>
    </div>
  </section>

  <!-- 团队生活 -->
  {
    lifeTeaser.length > 0 && (
      <section class="container home-section home-life">
        <SectionHead title={u.home.lifeTitle} en={u.home.lifeEn} desc={t(site.pages?.life, lang)}>
          <a slot="action" class="sec-more" href={href('life', lang)}>
            {u.home.allLife}
            <Icon name="arrow" size={15} />
          </a>
        </SectionHead>
        <div class="life-mosaic">
          {lifeTeaser.map((a: any, i: number) => (
            <a class="life-tile" href={`${href('life', lang)}${a.id ? `#${a.id}` : ''}`} data-reveal style={`--d:${i * 80}ms`}>
              <img src={asset(a.coverSrc)} alt={t(a.title, lang)} loading="lazy" />
              <span class="life-tile-cap">
                <span class="life-tile-meta">
                  {t(a.tag, lang)}
                  {a.date ? ` · ${formatDate(String(a.date), lang)}` : ''}
                </span>
                <b>{t(a.title, lang)}</b>
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- 发表期刊与会议 -->
  <section class="venues" aria-label={u.home.venuesTitle}>
    <p class="container venues-title">{u.home.venuesTitle}</p>
    <div class="marquee" data-marquee data-speed="40">
      <div class="marquee-track">
        {
          [0, 1].map((k) => (
            <ul aria-hidden={k === 1 ? 'true' : undefined}>
              {marqueeVenues.map((v) => (
                <li>{v}</li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>
</Base>
