---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import NetCanvas from '../components/NetCanvas.astro';
import Avatar from '../components/Avatar.astro';
import DirectionArt from '../components/DirectionArt.astro';
import {
  site,
  research,
  news,
  life,
  publications,
  papersTotal,
  projectsLedTotal,
  grantedInventions,
  newsLink,
  pi,
  t,
  list,
  href,
  asset,
  paragraphs,
  formatDate,
  dateParts,
  initials,
  directionById,
  avatarColors,
  type Lang,
} from '../lib/site';
import { ui } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const u = ui[lang];
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const pad = (n: number) => String(n).padStart(2, '0');

const latest = news.slice(0, 7);
// 首页数据栏：填了 auto 的项目按网站数据自动计数，保证与各页面列表一致
const autoValue: Record<string, number> = {
  papers: publications.length,
  patents: grantedInventions.length,
  projects: projectsLedTotal,
  directions: research.length,
};
const stats: any[] = (site.stats ?? []).map((s: any) =>
  s.auto === 'papers' ? { ...s, ...papersTotal } : s.auto && s.auto in autoValue ? { ...s, value: autoValue[s.auto] } : s,
);
// 首页只放简短介绍（members.yaml 的 summary），详细介绍在单独的导师页面
const piBio = t(pi.summary, lang) || (paragraphs(t(pi.bio, lang))[0] ?? '');
const piPage = href('people/wangzhengning', lang);
// 轮播图中的论文：publications.yaml 中 slide: true 的论文，按影响因子从高到低排列
const slidePapers = publications.filter((p) => p.slide === true).sort((a, b) => (b.impact ?? 0) - (a.impact ?? 0) || b.year - a.year);
const photoSlides: any[] = site.slides ?? [];
const slideCount = 1 + photoSlides.length + slidePapers.length;
// 「阅读论文」：有可公开的 PDF 时直接打开 PDF，否则打开出版社页面
const readUrl = (p: any) => (p.pdf ? asset(p.pdf) : p.doi ? `https://doi.org/${p.doi}` : href('publications', lang));
const piOther = t(pi.name, other);
// 导师的研究兴趣；没填时用课题组的研究方向
const piInterests = list(pi.interests, lang).length ? list(pi.interests, lang) : research.map((r) => t(r.short, lang));
const [pc1, pc2] = avatarColors(t(pi.name, 'en'));
const piTile = `--c1:${pc1};--c2:${pc2}`;

// 页尾滚动的期刊与会议；条目少时重复补满，保证无缝滚动
const venues: string[] = site.venues ?? [];
const marqueeVenues = venues.length ? Array.from({ length: Math.ceil(16 / venues.length) }, () => venues).flat() : [];
const tickerNews = news.slice(0, 8);
// 团队生活：最新 5 个有封面的相册（第一个放大）
const lifeTeaser = life
  .map((a: any) => ({ ...a, coverSrc: a.cover || (a.photos ?? []).find((p: any) => /\.(jpe?g|png|webp)$/i.test(p?.src ?? ''))?.src }))
  .filter((a: any) => a.coverSrc)
  .slice(0, 5);
---

<Base lang={lang}>
  <h1 class="sr-only">{t(site.name, lang)}{t(site.affiliation, lang) && ` · ${t(site.affiliation, lang)}`}</h1>

  <!-- 滚动新闻播报 -->
  <section class="ticker" aria-label={u.home.newsTitle}>
    <div class="container ticker-inner">
      <a class="ticker-label" href={href('news', lang)}>
        <span class="ticker-dot" aria-hidden="true"></span>
        {u.home.tickerLabel}
      </a>
      <div class="ticker-viewport" data-marquee data-speed="60">
        <div class="marquee-track">
          {
            [0, 1].map((k) => (
              <ul aria-hidden={k === 1 ? 'true' : undefined}>
                {tickerNews.map((n) => {
                  const l = newsLink(n, lang);
                  return (
                    <li>
                      <time datetime={n.date}>{formatDate(n.date, lang)}</time>
                      <a href={l.url} target={l.external ? '_blank' : undefined} rel="noopener" tabindex={k === 1 ? -1 : undefined}>
                        {t(n.title, lang)}
                      </a>
                    </li>
                  );
                })}
              </ul>
            ))
          }
        </div>
      </div>
      <a class="ticker-more" href={href('news', lang)}>{u.home.allNews}<Icon name="arrow" size={14} /></a>
    </div>
  </section>

  <!-- 轮播：导师介绍 + 照片 + 各方向代表作 -->
  <section class="container home-slider">
    <div class="slider" data-slider data-interval="7000" aria-roledescription="carousel">
      <div class="slides">
        <!-- 第一张：导师个人介绍（参考 MCL 打开即见的 Director 页面） -->
        <article class="slide slide-pi is-active" data-slide aria-label={u.a11y.slide(1)}>
          <div class="slide-pi-photo" style={piTile}>
            {pi.photo ? <img src={asset(pi.photo)} alt={t(pi.name, lang)} /> : <span aria-hidden="true">{initials(pi.name, lang)}</span>}
          </div>
          <div class="slide-pi-copy">
            <p class="slide-eyebrow">{u.home.piSlideEyebrow}</p>
            <h2 class="slide-pi-name">
              {t(pi.name, lang)}
              {piOther !== t(pi.name, lang) && <span>{piOther}</span>}
            </h2>
            <p class="slide-pi-title">{t(pi.title, lang)}{t(site.affiliation, lang) && ` · ${t(site.affiliation, lang)}`}</p>
            <p class="slide-pi-bio">{piBio}</p>
            <p class="slide-pi-interests">
              <b>{u.home.piInterests}</b>
              {piInterests.join(lang === 'zh' ? '、' : ', ')}
            </p>
            <div class="slide-pi-actions">
              <a class="btn btn-primary" href={piPage}>
                {u.home.piHome}
                <Icon name="arrow" />
              </a>
              {
                pi.email && (
                  <a class="btn btn-outline" href={`mailto:${pi.email}`}>
                    <Icon name="mail" />
                    {pi.email}
                  </a>
                )
              }
            </div>
          </div>
          <!-- 宽屏时右侧显示研究兴趣与链接，填满留白 -->
          <aside class="slide-pi-aside">
            <p class="slide-pi-aside-title">
              {u.people.interests}
              {lang === 'zh' && <small>Research Interests</small>}
            </p>
            <ul class="slide-pi-tags">
              {piInterests.map((x) => (
                <li>{x}</li>
              ))}
            </ul>
            {
              (pi.links ?? []).length > 0 && (
                <div class="slide-pi-links">
                  {(pi.links ?? []).map((l: any) => (
                    <a href={l.url} target="_blank" rel="noopener">
                      {t(l.label, lang)}
                      <Icon name="external" size={13} />
                    </a>
                  ))}
                </div>
              )
            }
          </aside>
        </article>

        {
          photoSlides.map((s, i) => (
            <article class="slide slide-photo" data-slide aria-hidden="true" aria-label={u.a11y.slide(i + 2)}>
              <img src={asset(s.image)} alt={t(s.caption, lang)} loading="lazy" />
              {s.caption && <p class="slide-photo-caption">{t(s.caption, lang)}</p>}
            </article>
          ))
        }

        {
          slidePapers.map((p, i) => {
            // 轮播不显示方向标签，只用方向的颜色作点缀；未归入研究方向的论文用主题蓝
            const r = directionById(p!.direction);
            return (
              <article
                class:list={['slide slide-paper', { 'has-figure': p!.figure }]}
                data-slide
                style={`--c:${r?.color ?? '#0b5eb2'}`}
                aria-hidden="true"
                aria-label={u.a11y.slide(i + 2 + photoSlides.length)}
              >
                {p!.figure ? (
                  <div class="slide-art slide-figure">
                    <figure>
                      <a href={asset(p!.figure)} target="_blank" rel="noopener" tabindex="-1">
                        <img src={asset(p!.figure)} alt={t(p!.figure_caption, lang) || p!.title} loading="lazy" />
                      </a>
                      <figcaption>
                        {t(p!.figure_caption, lang) ? `${t(p!.figure_caption, lang)} · ${u.home.figZoom}` : u.home.figCaption}
                      </figcaption>
                    </figure>
                  </div>
                ) : (
                  r && (
                    <div class="slide-art">
                      <DirectionArt art={r.art} color={r.color} uid={`s${i}`} />
                    </div>
                  )
                )}
                <div class="slide-copy">
                  <div class="slide-tags">
                    {p!.short && <span class="cite-venue cite-venue-light">{p!.short}</span>}
                    {p!.impact && <span class="cite-if">IF {p!.impact.toFixed(1)}</span>}
                  </div>
                  <h2 class="slide-title">{p!.title}</h2>
                  <p class="slide-summary">{t(p!.summary, lang) || (r ? t(r.summary, lang) : '')}</p>
                  <a class="btn btn-orange" href={readUrl(p)} target="_blank" rel="noopener" tabindex="-1">
                    {p!.pdf ? u.home.readPdf : u.home.readPaper}
                    <Icon name={p!.pdf ? 'doc' : 'arrow'} />
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>

      <button class="slider-arrow slider-prev" type="button" data-prev aria-label={u.a11y.prev}><Icon name="chevron-left" size={22} /></button>
      <button class="slider-arrow slider-next" type="button" data-next aria-label={u.a11y.next}><Icon name="chevron-right" size={22} /></button>
      <div class="slider-dots">
        <button class="slider-play" type="button" data-play aria-label={u.a11y.pause} data-label-play={u.a11y.play} data-label-pause={u.a11y.pause}>
          <Icon name="pause" size={14} class="i-pause" />
          <Icon name="play" size={14} class="i-play" />
        </button>
        {
          Array.from({ length: slideCount }, (_, i) => (
            <button class:list={['slider-dot', { 'is-active': i === 0 }]} type="button" data-dot={i} aria-label={u.a11y.slide(i + 1)}>
              <span></span>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 关于 -->
  <section class="container home-about">
    <div>
      <SectionHead title={u.home.aboutTitle} en={u.home.aboutEn} />
      <p class="about-lead" data-words>{t(site.intro, lang)}</p>
    </div>
    <dl class="about-stats">
      {
        stats.map((s, i) => (
          <div class:list={['about-stat', { 'is-accent': s.accent }]} data-reveal style={`--d:${i * 90}ms`}>
            <dd data-count={s.value} data-suffix={s.suffix ?? ''}>
              {s.value}
              {s.suffix}
            </dd>
            <dt>{t(s.label, lang)}</dt>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- 新闻 + 侧栏 -->
  <div class="band-soft">
  <div class="container home-grid">
    <section class="home-main">
      <SectionHead title={u.home.newsTitle} en={u.home.newsEn}>
        <a slot="action" class="sec-more" href={href('news', lang)}>{u.home.allNews}<Icon name="arrow" size={15} /></a>
      </SectionHead>
      <ul class="news-list">
        {
          latest.map((n, i) => {
            const d = dateParts(n.date);
            const { url: link, external } = newsLink(n, lang);
            return (
              <li class="news-row" data-reveal style={`--d:${i * 80}ms`}>
                <a class="news-thumb" href={link} tabindex="-1" aria-hidden="true" target={external ? '_blank' : undefined} rel="noopener">
                  {n.image ? (
                    <img src={asset(n.image)} alt="" loading="lazy" />
                  ) : (
                    <span class="news-tile">
                      <b class:list={{ 'is-long': String(n.tag ?? '').length > 10 }}>{n.tag ?? `${d.m}/${d.d}`}</b>
                      <small>{d.y}</small>
                    </span>
                  )}
                </a>
                <div class="news-body">
                  <a class="news-title" href={link} target={external ? '_blank' : undefined} rel="noopener">
                    {t(n.title, lang)}
                  </a>
                  <span class="news-meta">
                    <time class="news-date" datetime={n.date}>
                      {formatDate(n.date, lang)}
                    </time>
                  </span>
                  {n.body && <p class="news-excerpt">{t(n.body, lang)}</p>}
                </div>
              </li>
            );
          })
        }
      </ul>
    </section>

    <aside class="home-side">
      <section class="side-card" data-reveal>
        <h2 class="side-title">{u.home.piLabel}</h2>
        <a class="side-pi" href={piPage}>
          <Avatar name={pi.name} photo={pi.photo} lang={lang} size={72} />
          <span>
            <b>{t(pi.name, lang)}</b>
            <small>{t(pi.title, lang)}</small>
          </span>
        </a>
        <p class="side-pi-bio">{piBio}</p>
        <a class="sec-more" href={piPage}>{u.home.piHome}<Icon name="arrow" size={15} /></a>
      </section>

      <section class="side-card" data-reveal style="--d:100ms">
        <h2 class="side-title">{u.home.sideResearch}</h2>
        <ul class="side-dirs">
          {
            research.map((r) => (
              <li>
                <a href={`${href('research', lang)}#${r.id}`} style={`--c:${r.color}`}>
                  <span class="side-dir-icon">
                    <Icon name={r.icon} size={15} />
                  </span>
                  {t(r.title, lang)}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="side-card side-join" data-reveal style="--d:200ms">
        <h2 class="side-title">{u.home.joinTitle}</h2>
        <p>{u.home.joinShort}</p>
        <a class="btn btn-orange btn-sm" href={href('join', lang)}>{u.home.joinBtn}<Icon name="arrow" size={16} /></a>
      </section>
    </aside>
  </div>
  </div>

  <!-- 研究方向（深蓝色背景带） -->
  <section class="band-navy">
    <NetCanvas density={0.5} />
    <div class="container home-section">
    <SectionHead title={u.home.researchTitle} en={u.home.researchEn} desc={t(site.pages?.research, lang)}>
      <a slot="action" class="sec-more" href={href('research', lang)}>{u.home.allResearch}<Icon name="arrow" size={15} /></a>
    </SectionHead>
    <div class="sub-grid">
      {
        research.map((r, i) => (
          <a class="sub-card" href={`${href('research', lang)}#${r.id}`} style={`--c:${r.color};--d:${(i % 2) * 100}ms`} data-reveal>
            <span class="sub-icon">
              <Icon name={r.icon} size={26} />
            </span>
            <span class="sub-body">
              <span class="sub-num">{pad(i + 1)}</span>
              <h3 class="sub-title">{t(r.title, lang)}</h3>
              <span class="sub-en">{t(r.title, other)}</span>
              <span class="sub-sum">{t(r.summary, lang)}</span>
              <span class="sub-more">
                {u.common.learnMore}
                <Icon name="arrow" size={15} />
              </span>
            </span>
          </a>
        ))
      }
    </div>
    </div>
  </section>

  <!-- 团队生活 -->
  {
    lifeTeaser.length > 0 && (
      <section class="container home-section home-life">
        <SectionHead title={u.home.lifeTitle} en={u.home.lifeEn} desc={t(site.pages?.life, lang)}>
          <a slot="action" class="sec-more" href={href('life', lang)}>
            {u.home.allLife}
            <Icon name="arrow" size={15} />
          </a>
        </SectionHead>
        <div class="life-mosaic">
          {lifeTeaser.map((a: any, i: number) => (
            <a class="life-tile" href={`${href('life', lang)}${a.id ? `#${a.id}` : ''}`} data-reveal style={`--d:${i * 80}ms`}>
              <img src={asset(a.coverSrc)} alt={t(a.title, lang)} loading="lazy" />
              <span class="life-tile-cap">
                <span class="life-tile-meta">
                  {t(a.tag, lang)}
                  {a.date ? ` · ${formatDate(String(a.date), lang)}` : ''}
                </span>
                <b>{t(a.title, lang)}</b>
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- 发表期刊与会议 -->
  <section class="venues" aria-label={u.home.venuesTitle}>
    <p class="container venues-title">{u.home.venuesTitle}</p>
    <div class="marquee" data-marquee data-speed="40">
      <div class="marquee-track">
        {
          [0, 1].map((k) => (
            <ul aria-hidden={k === 1 ? 'true' : undefined}>
              {marqueeVenues.map((v) => (
                <li>{v}</li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </section>
</Base>
