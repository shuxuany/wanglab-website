---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { site, pi, groups, alumni, t, list, asset, href, initials, avatarColors, paragraphs, type Lang } from '../lib/site';
import { ui } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const u = ui[lang];
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const piOther = t(pi.name, other);
const tile = (name: any) => {
  const [c1, c2] = avatarColors(t(name, 'en'));
  return `--c1:${c1};--c2:${c2}`;
};
// 毕业校友没有照片时用卡通头像：members.yaml 中 gender 为 m / f 时分男女，不填时为中性头像
const avatarOf = (a: any) => `images/avatars/${a.gender === 'm' ? 'male' : a.gender === 'f' ? 'female' : 'default'}.svg`;
---

<Base lang={lang} title={u.nav.people} description={t(site.pages?.people, lang)}>
  <PageHero eyebrow="People" title={u.people.title} desc={t(site.pages?.people, lang)} lang={lang} />

  <div class="container page-body">
    <SectionHead title={u.people.pi} en="Principal Investigator" id="pi" />
    <article class="pi-block" data-reveal>
      <div class="pi-photo" style={tile(pi.name)}>
        {pi.photo ? <img src={asset(pi.photo)} alt={t(pi.name, lang)} /> : <span aria-hidden="true">{initials(pi.name, lang)}</span>}
      </div>
      <div class="pi-info">
        <h2 class="pi-name">
          {t(pi.name, lang)}
          {piOther && piOther !== t(pi.name, lang) && <span class="pi-name-alt">{piOther}</span>}
        </h2>
        <p class="pi-title">{t(pi.title, lang)}</p>
        <div class="pi-links">
          {
            pi.email && (
              <a class="pill" href={`mailto:${pi.email}`}>
                <Icon name="mail" size={15} />
                {pi.email}
              </a>
            )
          }
          {
            (pi.links ?? []).map((l: any) => (
              <a class="pill" href={l.url} target="_blank" rel="noopener">
                {t(l.label, lang)}
                <Icon name="external" size={13} />
              </a>
            ))
          }
        </div>
        {
          list(pi.interests, lang).length > 0 && (
            <div class="pi-interests">
              <h3 class="mini-title">{u.people.interests}</h3>
              <div class="tags">
                {list(pi.interests, lang).map((k) => (
                  <span class="tag">{k}</span>
                ))}
              </div>
            </div>
          )
        }
        <div class="prose">
          <p>{t(pi.summary, lang) || paragraphs(t(pi.bio, lang))[0]}</p>
        </div>
        <a class="btn btn-primary pi-more" href={href('people/wangzhengning', lang)}>
          {u.home.piHome}
          <Icon name="arrow" />
        </a>
      </div>
    </article>

    <div id="students">
      {
        groups.map((g) => (
          <section class="people-group">
            <SectionHead title={t(g.role, lang)} en={t(g.role, other)} />
            <ul class="person-grid">
              {g.members.map((m, i) => (
                <li class="person" data-reveal style={`--d:${(i % 5) * 70}ms`}>
                  <div class="person-photo" style={tile(m.name)}>
                    {m.photo ? <img src={asset(m.photo)} alt={t(m.name, lang)} loading="lazy" /> : <span aria-hidden="true">{initials(m.name, lang)}</span>}
                  </div>
                  <p class="person-name">{t(m.name, lang)}</p>
                  {m.since && <p class="person-meta">{u.people.since(m.since)}</p>}
                  {m.topic && <p class="person-topic">{t(m.topic, lang)}</p>}
                  {m.email && (
                    <a class="person-email" href={`mailto:${m.email}`}>
                      {m.email}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    {
      alumni.length > 0 && (
        <section class="people-group" id="alumni">
          <SectionHead title={u.people.alumni} en={ui[other].people.alumni} />
          <ul class="alumni-grid">
            {alumni.map((a, i) => (
              <li class="alumnus" data-reveal style={`--d:${(i % 6) * 60}ms`}>
                <img class="alumnus-avatar" src={asset(a.photo || avatarOf(a))} alt={a.photo ? t(a.name, lang) : ''} loading="lazy" />
                <p class="alumnus-name">{t(a.name, lang)}</p>
                <p class="alumnus-meta">{u.people.cohort(a.year, a.degree)}</p>
                {a.now && <p class="alumnus-now">{t(a.now, lang)}</p>}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>
