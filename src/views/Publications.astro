---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PubItem from '../components/PubItem.astro';
import OutputSwitch from '../components/OutputSwitch.astro';
import Icon from '../components/Icon.astro';
import { site, publications, papersSince, isLabLed, categoriesOf, pubType, t, type Lang, type Publication } from '../lib/site';
import { ui } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const u = ui[lang];
// 只展示近十年（site.yaml 的 papers_since 及以后）的论文，更早的以省略号表示
const shown = publications.filter((p) => !papersSince || p.year >= papersSince);
const hasOlder = shown.length < publications.length;
const years = [...new Set(shown.map((p) => p.year))].sort((a, b) => b - a);
const tabs: [string, string][] = [['all', u.pubs.all], ...(u.sub.pubs as [string, string][])];
// 「高影响因子论文」：课题组主导的期刊论文（有影响因子）和 CCF-A / B 类会议论文一起排序，取前 10 篇放在列表最前面；
// 依次为 CCF-A 期刊和会议 → 其余期刊（影响因子从高到低）→ CCF-B 会议，同等级内较新的在前
const tier = (p: Publication) => (p.ccf === 'A' ? 0 : pubType(p) === 'conference' ? 2 : 1);
const top = shown
  .filter(
    (p) => isLabLed(p) && (typeof p.impact === 'number' || (pubType(p) === 'conference' && (p.ccf === 'A' || p.ccf === 'B'))),
  )
  .sort((a, b) => tier(a) - tier(b) || (b.impact ?? 0) - (a.impact ?? 0) || b.year - a.year)
  .slice(0, 10);
---

<Base lang={lang} title={u.nav.publications} description={t(site.pages?.publications, lang)}>
  <PageHero eyebrow="Research Output" title={u.pubs.title} desc={t(site.pages?.publications, lang)} lang={lang} />

  <div class="container page-body" data-pubs>
    <OutputSwitch lang={lang} active="papers" />
    <div class="pub-controls" data-reveal>
      <div class="tabs" role="tablist" data-tabs>
        {
          tabs.map(([id, label]) => (
            <button class:list={['tab', { 'is-active': id === 'all' }]} type="button" role="tab" aria-selected={id === 'all' ? 'true' : 'false'} data-type-tab={id}>
              {label}
            </button>
          ))
        }
        <span class="tab-indicator" aria-hidden="true"></span>
      </div>
      <div class="pub-filters">
        <label class="search">
          <Icon name="search" />
          <input type="search" placeholder={u.pubs.search} aria-label={u.pubs.search} data-pub-search />
        </label>
        <select class="select" data-pub-year aria-label={u.pubs.allYears}>
          <option value="all">{u.pubs.allYears}</option>
          {years.map((y) => <option value={y}>{y}</option>)}
        </select>
      </div>
      <div class="chips" role="group" aria-label={u.pubs.byCategory}>
        <button class="chip is-active" type="button" data-cat-chip="all" aria-pressed="true">{u.pubs.allCategories}</button>
        {
          categoriesOf(shown).map((c) => (
            <button class="chip" type="button" data-cat-chip={c.id} aria-pressed="false" style={`--c:${c.color}`}>
              <i />
              {t(c.name, lang)}
            </button>
          ))
        }
      </div>
    </div>

    <!-- 只在筛选或搜索时显示条数 -->
    <p class="pub-count" data-pub-count data-hide-unfiltered data-template={u.pubs.count} hidden>{u.pubs.count.replace('{n}', String(shown.length))}</p>

    {
      top.length > 0 && (
        <section class="pub-top" data-pub-top>
          <h2 class="year-label pub-top-label">
            {u.pubs.top}
            <small>{u.pubs.topNote}</small>
          </h2>
          <ol class="cite-list cite-top">
            {top.map((p) => (
              <PubItem pub={p} lang={lang} impact={p.impact} ccf={pubType(p) === 'conference' ? p.ccf : undefined} filterable={false} />
            ))}
          </ol>
        </section>
      )
    }

    <h2 class="year-label pub-section-label">{u.pubs.decade}</h2>

    <div class="pub-results no-num">
      {
        years.map((y) => (
          <section class="year-group" data-year-group>
            <h2 class="year-label">{y}</h2>
            <ol class="cite-list">
              {shown
                .filter((p) => p.year === y)
                .map((p) => (
                  <PubItem pub={p} lang={lang} />
                ))}
            </ol>
          </section>
        ))
      }
    </div>
    {
      hasOlder && (
        <p class="pub-more" data-pub-more aria-label={u.pubs.older}>
          ……
        </p>
      )
    }
    <p class="pub-empty" data-pub-empty hidden>{u.pubs.empty}</p>
  </div>
</Base>

<script>
  import '../scripts/pub-filter';
</script>
